<!-- Endorsement Submission Modal -->
<div class="modal fade" id="spEndorseModal" tabindex="-1" aria-labelledby="spEndorseModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 shadow-lg border-0">
            <form action="{{endorse_action_url}}" method="post">
                <input type="hidden" name="action" value="add" />
                <input type="hidden" name="targetid" value="{{userid}}" />
                <input type="hidden" name="sesskey" value="{{sesskey}}" />

                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold" id="spEndorseModalLabel">
                        <i class="fa fa-stamp text-primary me-2" aria-hidden="true"></i> {{#str}}write_endorsement, local_smartprofile{{/str}}
                    </h5>
                    <button type="button" class="close btn-close" data-dismiss="modal" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <div class="modal-body py-3">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-uppercase">{{#str}}endorsed_skill, local_smartprofile{{/str}} <span class="text-danger">*</span></label>
                        <input type="text" name="skill" class="form-control rounded-3" placeholder="{{#str}}endorsed_skill_placeholder, local_smartprofile{{/str}}" required />
                    </div>

                    {{#has_shared_courses}}
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-uppercase">{{#str}}course, moodle, Course{{/str}}</label>
                        <select name="courseid" class="form-select rounded-3">
                            <option value="0">-- {{#str}}general_endorsement, local_smartprofile{{/str}} --</option>
                            {{#shared_courses}}
                            <option value="{{id}}">{{fullname}}</option>
                            {{/shared_courses}}
                        </select>
                    </div>
                    {{/has_shared_courses}}

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-uppercase">{{#str}}rating, local_smartprofile{{/str}}</label>
                        <select name="rating" class="form-select rounded-3">
                            <option value="5">⭐⭐⭐⭐⭐ 5 / 5 ({{#str}}rating_exceptional, local_smartprofile{{/str}})</option>
                            <option value="4">⭐⭐⭐⭐ 4 / 5 ({{#str}}rating_very_good, local_smartprofile{{/str}})</option>
                            <option value="3">⭐⭐⭐ 3 / 5 ({{#str}}rating_good, local_smartprofile{{/str}})</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-uppercase">{{#str}}recommendation_text, local_smartprofile{{/str}}</label>
                        <textarea name="recommendation" class="form-control rounded-3" rows="4" placeholder="{{#str}}recommendation_placeholder, local_smartprofile{{/str}}"></textarea>
                    </div>
                </div>

                <div class="modal-footer border-top-0 pt-0">
