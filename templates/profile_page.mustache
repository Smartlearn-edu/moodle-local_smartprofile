{{!
    @template local_smartprofile/profile_page

    Smart Profile - Digital Learner Identity & Academic Portfolio Template.
}}

<div class="smartprofile-container" data-sp-theme="{{thememode}}" {{#custom_style_string}}style="{{custom_style_string}}"{{/custom_style_string}}>

    {{#custom_css}}
        <style>
            {{{custom_css}}}
        </style>
    {{/custom_css}}

    <!-- 1. Hero Card: Identity First -->
    <div class="sp-hero-card">
        <div class="sp-cover-banner">
            <div class="sp-cover-overlay"></div>
            <!-- Top Right Action Controls -->
            <div class="sp-banner-actions">
                {{#showclassiclinks}}
                    <div class="dropdown d-inline-block">
                        <button class="sp-hero-btn sp-hero-btn-light dropdown-toggle" type="button" id="spClassicProfileMenu" data-toggle="dropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" title="{{#str}}moodle_system_profile, local_smartprofile{{/str}}">
                            <i class="fa fa-cubes text-info" aria-hidden="true"></i> <span>{{#str}}classic_profile, local_smartprofile{{/str}}</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-right dropdown-menu-end shadow-lg border-0 rounded-3 p-2 sp-classic-dropdown" aria-labelledby="spClassicProfileMenu" style="min-width: 260px; z-index: 1050;">
                            <li>
                                <a class="dropdown-item rounded-2 py-2 fw-bold text-primary" href="{{classic_profile_url}}">
                                    <i class="fa fa-arrow-up-right-from-square me-2" aria-hidden="true"></i> {{#str}}view_classic_profile, local_smartprofile{{/str}}
                                </a>
                            </li>
                            {{#has_course_profile}}
                            <li>
                                <a class="dropdown-item rounded-2 py-2 fw-semibold text-success" href="{{course_profile_url}}">
                                    <i class="fa fa-graduation-cap me-2" aria-hidden="true"></i> {{#str}}course_profile, local_smartprofile{{/str}} ({{course_name}})
                                </a>
                            </li>
                            {{/has_course_profile}}
                            {{#has_system_reports}}
                            <li><hr class="dropdown-divider my-1"></li>
                            <li class="dropdown-header small text-uppercase fw-bold text-muted px-3 py-1">{{#str}}reports_and_logs, local_smartprofile{{/str}}</li>
                            {{#system_reports}}
                            <li>
                                <a class="dropdown-item rounded-2 py-1 small" href="{{url}}">
                                    <i class="fa {{icon}} me-2 text-muted" aria-hidden="true"></i> {{title}}
                                </a>
                            </li>
                            {{/system_reports}}
                            {{/has_system_reports}}
                            {{#has_system_contributions}}
                            <li><hr class="dropdown-divider my-1"></li>
                            <li class="dropdown-header small text-uppercase fw-bold text-muted px-3 py-1">{{#str}}user_contributions, local_smartprofile{{/str}}</li>
                            {{#system_contributions}}
                            <li>
                                <a class="dropdown-item rounded-2 py-1 small" href="{{url}}">
                                    <i class="fa {{icon}} me-2 text-muted" aria-hidden="true"></i> {{title}}
                                </a>
                            </li>
                            {{/system_contributions}}
                            {{/has_system_contributions}}
                        </ul>
                    </div>
                {{/showclassiclinks}}
                {{#dashboardurl}}
                    <a href="{{dashboardurl}}" class="sp-hero-btn sp-hero-btn-light sp-hero-btn-dashboard" title="{{#str}}open_smartdashboard, local_smartprofile{{/str}}">
                        <i class="fa fa-gauge-high text-primary" aria-hidden="true"></i> <span>SmartDashboard</span>
                    </a>
                {{/dashboardurl}}
                {{#cvurl}}
                    <a href="{{cvurl}}" target="_blank" rel="noopener" class="sp-hero-btn sp-hero-btn-light sp-hero-btn-cv" title="{{#str}}export_cv, local_smartprofile{{/str}}">
                        <i class="fa fa-file-pdf text-danger" aria-hidden="true"></i> <span>{{#str}}export_cv, local_smartprofile{{/str}}</span>
                    </a>
                {{/cvurl}}
                {{#showmessage}}
                    <a href="{{messageurl}}" class="sp-hero-btn sp-hero-btn-primary">
                        <i class="fa fa-comment" aria-hidden="true"></i> <span>{{#str}}message, message, Message{{/str}}</span>
                    </a>
                {{/showmessage}}
                {{#canedit}}
                    <a href="{{editurl}}" class="sp-hero-btn sp-hero-btn-light">
                        <i class="fa fa-pen" aria-hidden="true"></i> {{#str}}editprofile, local_smartprofile{{/str}}
                    </a>
                {{/canedit}}
                {{#preferencesurl}}
                    <a href="{{preferencesurl}}" class="sp-hero-btn sp-hero-btn-icon" title="{{#str}}preferences, local_smartprofile{{/str}}">
                        <i class="fa fa-cog" aria-hidden="true"></i>
                    </a>
                {{/preferencesurl}}
                {{#showproupgrade}}
                    <a href="https://services.smartlearn.education/services/plugins/local_smartprofile" target="_blank" rel="noopener" class="sp-hero-btn sp-hero-btn-pro" title="{{#str}}upgrade_to_pro_title, local_smartprofile{{/str}}">
                        <i class="fa fa-star text-warning" aria-hidden="true"></i> <span>{{#str}}upgrade_to_pro, local_smartprofile{{/str}}</span>
                    </a>
                {{/showproupgrade}}
            </div>
        </div>

        <div class="sp-hero-content">
            <div class="sp-hero-left">
                <div class="sp-avatar-holder">
                    <img src="{{avatarurl}}" alt="{{fullname}}" class="sp-hero-avatar" />
                    <span class="sp-status-indicator" title="Active"></span>
                </div>

                <div class="sp-identity-details">
                    <div class="sp-name-row">
                        <h1 class="sp-hero-name">{{fullname}}</h1>
                        <span class="sp-verified-badge" title="Verified Learner"><i class="fa fa-check-circle" aria-hidden="true"></i></span>
                    </div>

                    <div class="sp-headline-text">
                        <i class="fa fa-graduation-cap" aria-hidden="true"></i> {{{headline}}}
                    </div>

                    {{#bio_quote}}
                        <div class="sp-bio-quote">
                            "{{bio_quote}}"
                        </div>
                    {{/bio_quote}}

                    <div class="sp-status-pills">
                        <span class="sp-status-pill sp-pill-active">
                            <span class="sp-pulse-dot"></span> {{#str}}active, moodle, Active{{/str}}
                        </span>
                        {{#membersince}}
                            <span class="sp-status-pill">
                                <i class="fa fa-calendar-alt" aria-hidden="true"></i> {{#str}}membersince, local_smartprofile, Member since{{/str}} {{membersince}}
                            </span>
                        {{/membersince}}
                        {{#has_location}}
                            <span class="sp-status-pill">
                                <i class="fa fa-location-dot" aria-hidden="true"></i> {{locationstring}}
                            </span>
                        {{/has_location}}
                    </div>
                </div>
            </div>

        </div>
    </div>

    {{^isfaculty}}
    {{#has_credithours_breakdown}}
    <!-- Academic Credit Hours Category Breakdown Section -->
    <div class="sp-credithours-box card border shadow-sm mb-4">
        <div class="sp-credithours-header d-flex align-items-center justify-content-between flex-wrap gap-3 pb-3 mb-3 border-bottom">
            <div class="sp-credithours-title-group d-flex align-items-center gap-3">
                <div class="sp-ch-header-icon rounded-3 d-flex align-items-center justify-content-center">
                    🎓
                </div>
                <div>
                    <h3 class="sp-ch-main-title h5 fw-bold mb-1">{{#str}}credithours_breakdown, local_smartprofile{{/str}}</h3>
                    <p class="sp-ch-subtitle text-muted small mb-0">{{#str}}credithours_breakdown_desc, local_smartprofile{{/str}}</p>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <div class="sp-ch-total-badge badge rounded-pill d-inline-flex align-items-center gap-2 py-2 px-3">
                    <span class="sp-ch-total-label opacity-75">{{#str}}totalcredithours, local_smartprofile{{/str}}:</span>
                    <span class="sp-ch-total-value fw-bold">{{gamification.credithours_display}}</span>
                </div>
                {{#gamification.has_share}}
                {{#gamification.share}}
                <a href="{{wallet_pass_url}}" class="sp-header-apple-btn btn btn-sm btn-dark rounded-pill d-inline-flex align-items-center gap-2 px-3 py-2 fw-semibold" title="{{#str}}add_to_apple_wallet, local_smartprofile{{/str}}">
                    <i class="fa-brands fa-apple" aria-hidden="true"></i>
                    <span>{{#str}}add_to_apple_wallet, local_smartprofile{{/str}}</span>
                </a>
                <a href="{{linkedin_add_url}}" target="_blank" rel="noopener noreferrer" class="sp-header-linkedin-btn btn btn-sm rounded-pill d-inline-flex align-items-center gap-2 px-3 py-2 fw-semibold" title="{{#str}}add_to_linkedin, local_smartprofile{{/str}}">
                    <i class="fa-brands fa-linkedin" aria-hidden="true"></i>
                    <span>{{#str}}add_to_linkedin, local_smartprofile{{/str}}</span>
                </a>
                {{/gamification.share}}
                {{/gamification.has_share}}
            </div>
        </div>

        <div class="sp-credithours-grid">
            {{#credithours_breakdown}}
            <div class="sp-ch-cat-card card border rounded-3 p-3">
                <div class="sp-ch-cat-header mb-2">
                    <div class="sp-ch-cat-name-box d-flex align-items-center gap-2 mb-2">
                        <span class="sp-ch-cat-icon d-inline-flex align-items-center justify-content-center rounded-circle">
                            <i class="fa fa-folder-open" aria-hidden="true"></i>
                        </span>
                        <span class="sp-ch-cat-name fw-bold">{{parent_name}}</span>
                    </div>
                    <div class="sp-ch-cat-total-box d-flex align-items-center justify-content-between gap-2 flex-wrap">
                        <span class="sp-ch-cat-total-pill badge rounded-pill px-3 py-2 fw-bold">{{total_hours}}</span>
                        {{#has_share}}
                        {{#share}}
                        <div class="sp-ch-card-share-actions d-flex align-items-center gap-1">
                            <a href="{{wallet_pass_url}}" class="sp-ch-share-icon-btn sp-share-apple" title="{{#str}}add_to_apple_wallet, local_smartprofile{{/str}}">
                                <i class="fa-brands fa-apple" aria-hidden="true"></i>
                            </a>
                            <a href="{{linkedin_add_url}}" target="_blank" rel="noopener noreferrer" class="sp-ch-share-icon-btn sp-share-linkedin" title="{{#str}}add_to_linkedin, local_smartprofile{{/str}}">
                                <i class="fa-brands fa-linkedin" aria-hidden="true"></i>
                            </a>
                            <a href="{{x_url}}" target="_blank" rel="noopener noreferrer" class="sp-ch-share-icon-btn sp-share-x" title="{{#str}}share_to_x, local_smartprofile{{/str}}">
                                <i class="fa-brands fa-x-twitter" aria-hidden="true"></i>
                            </a>
                            <a href="{{whatsapp_url}}" target="_blank" rel="noopener noreferrer" class="sp-ch-share-icon-btn sp-share-whatsapp" title="{{#str}}share_to_whatsapp, local_smartprofile{{/str}}">
                                <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
                            </a>
                            <a href="{{verify_url}}" target="_blank" rel="noopener noreferrer" class="sp-ch-share-icon-btn sp-share-verify" title="{{#str}}copy_verify_link, local_smartprofile{{/str}}">
                                <i class="fa-shield-halved" aria-hidden="true"></i>
                            </a>
                        </div>
                        {{/share}}
                        {{/has_share}}
                    </div>
                </div>

                {{#has_subcategories}}
                <div class="sp-ch-subcat-list d-flex flex-column gap-2 pt-2 mt-1 border-top border-dashed">
                    {{#subcategories}}
                    <div class="sp-ch-subcat-item d-flex align-items-center justify-content-between p-2 rounded-2 gap-2">
                        <div class="sp-ch-subcat-info d-flex align-items-center gap-2 text-truncate">
                            <i class="fa fa-angle-right text-muted small" aria-hidden="true"></i>
                            <span class="sp-ch-subcat-title small fw-medium text-truncate">{{name}}</span>
                        </div>
                        <span class="sp-ch-subcat-amount badge bg-secondary bg-opacity-10 text-secondary fw-semibold small px-2 py-1">{{hours}}</span>
                    </div>
                    {{/subcategories}}
                </div>
                {{/has_subcategories}}
            </div>
            {{/credithours_breakdown}}
        </div>
    </div>
    {{/has_credithours_breakdown}}
    {{/isfaculty}}

    <!-- 2. Profile Facts Strip (Horizontal 6-Metric Ribbon) -->
    <div class="sp-facts-ribbon">
        {{#isfaculty}}
        {{#faculty}}
        <div class="sp-fact-item">
            <div class="sp-fact-icon sp-fact-blue"><i class="fa fa-chalkboard-user" aria-hidden="true"></i></div>
            <div class="sp-fact-info">
                <div class="sp-fact-val">{{taughtcourses_count}}</div>
                <div class="sp-fact-lbl">{{#str}}taught_courses, local_smartprofile{{/str}}</div>
            </div>
        </div>

        <div class="sp-fact-item">
            <div class="sp-fact-icon sp-fact-purple"><i class="fa fa-users" aria-hidden="true"></i></div>
            <div class="sp-fact-info">
                <div class="sp-fact-val">{{total_students_instructed}}</div>
                <div class="sp-fact-lbl">{{#str}}students_instructed, local_smartprofile{{/str}}</div>
            </div>
        </div>

        <div class="sp-fact-item">
            <div class="sp-fact-icon sp-fact-indigo"><i class="fa fa-folder-tree" aria-hidden="true"></i></div>
            <div class="sp-fact-info">
                <div class="sp-fact-val">{{disciplines_count}}</div>
                <div class="sp-fact-lbl">{{#str}}academic_disciplines, local_smartprofile{{/str}}</div>
            </div>
        </div>

        <div class="sp-fact-item">
            <div class="sp-fact-icon sp-fact-amber"><i class="fa fa-award" aria-hidden="true"></i></div>
            <div class="sp-fact-info">
                <div class="sp-fact-val">{{badges_count}}</div>
                <div class="sp-fact-lbl">{{#str}}achievements, local_smartprofile{{/str}}</div>
            </div>
        </div>

        <div class="sp-fact-item">
            <div class="sp-fact-icon sp-fact-rose"><i class="fa fa-landmark" aria-hidden="true"></i></div>
            <div class="sp-fact-info">
                <div class="sp-fact-val">{{tenure_string}}</div>
                <div class="sp-fact-lbl">{{#str}}faculty_tenure, local_smartprofile, Academic Tenure{{/str}}</div>
            </div>
        </div>

        <div class="sp-fact-item">
            <div class="sp-fact-icon sp-fact-orange"><i class="fa fa-lightbulb" aria-hidden="true"></i></div>
            <div class="sp-fact-info">
                <div class="sp-fact-val">{{#skills}}{{skills.length}}{{/skills}}{{^skills}}1+{{/skills}}</div>
                <div class="sp-fact-lbl">{{#str}}research_interests, local_smartprofile{{/str}}</div>
            </div>
        </div>
        {{/faculty}}
        {{/isfaculty}}

        {{^isfaculty}}
        <div class="sp-fact-item">
            <div class="sp-fact-icon sp-fact-blue"><i class="fa fa-book-open" aria-hidden="true"></i></div>
            <div class="sp-fact-info">
                <div class="sp-fact-val">{{courses_count}}</div>
                <div class="sp-fact-lbl">{{#str}}coursesenrolled, local_smartprofile, Courses Enrolled{{/str}}</div>
            </div>
        </div>

        <div class="sp-fact-item">
            <div class="sp-fact-icon sp-fact-purple"><i class="fa fa-graduation-cap" aria-hidden="true"></i></div>
            <div class="sp-fact-info">
                <div class="sp-fact-val">{{courses_completed_count}}</div>
                <div class="sp-fact-lbl">{{#str}}coursescompleted, local_smartprofile, Courses Completed{{/str}}</div>
            </div>
        </div>

        <div class="sp-fact-item">
            <div class="sp-fact-icon sp-fact-indigo">
                <div class="sp-mini-gauge-donut" style="--gauge-val: {{overall_progress}}%;">
                    <i class="fa fa-chart-pie" aria-hidden="true"></i>
                </div>
            </div>
            <div class="sp-fact-info">
                <div class="sp-fact-val">{{overall_progress}}%</div>
                <div class="sp-fact-lbl">{{#str}}overallprogress, local_smartprofile, Overall Progress{{/str}}</div>
            </div>
        </div>

        <div class="sp-fact-item">
            <div class="sp-fact-icon sp-fact-amber"><i class="fa fa-certificate" aria-hidden="true"></i></div>
            <div class="sp-fact-info">
                <div class="sp-fact-val">{{certificates_count}}</div>
                <div class="sp-fact-lbl">{{#str}}certificates, local_smartprofile, Certificates{{/str}}</div>
            </div>
        </div>

        <div class="sp-fact-item">
            <div class="sp-fact-icon sp-fact-rose"><i class="fa fa-award" aria-hidden="true"></i></div>
            <div class="sp-fact-info">
                <div class="sp-fact-val">{{badges_count}}</div>
                <div class="sp-fact-lbl">{{#str}}badgesearned, local_smartprofile, Badges Earned{{/str}}</div>
            </div>
        </div>

        <div class="sp-fact-item">
            <div class="sp-fact-icon sp-fact-orange"><i class="fa fa-graduation-cap" aria-hidden="true"></i></div>
            <div class="sp-fact-info">
                <div class="sp-fact-val">{{gamification.credithours_display}}</div>
                <div class="sp-fact-lbl">{{#str}}credithours_earned, local_smartprofile, Credit Hours Earned{{/str}}</div>
            </div>
        </div>
        {{/isfaculty}}
    </div>

    <!-- 3. Main Two-Column Layout (68% Main / 32% Sidebar) -->
    <div class="sp-layout-grid">

        <!-- Main Column (Left) -->
        <div class="sp-main-col">

            {{#isfaculty}}
            {{#faculty}}
            <!-- Faculty: Taught Courses Showcase Card -->
            <div class="sp-portfolio-card">
                <div class="sp-card-title-row">
                    <h2 class="sp-card-heading">
                        <i class="fa fa-chalkboard-user sp-head-icon" aria-hidden="true"></i> {{#str}}taught_courses, local_smartprofile{{/str}}
                    </h2>
                </div>

                {{#has_taughtcourses}}
                <div class="sp-taught-courses-grid">
                    {{#taughtcourses}}
                        <a href="{{url}}" class="sp-taught-course-card">
                            <div class="sp-taught-course-thumb" {{#imageurl}}style="background-image: url('{{imageurl}}');"{{/imageurl}}>
                                {{^imageurl}}<i class="fa fa-graduation-cap" aria-hidden="true"></i>{{/imageurl}}
                                <span class="sp-taught-student-badge">
                                    <i class="fa fa-users" aria-hidden="true"></i> {{studentcount}} {{#str}}students, moodle, Students{{/str}}
                                </span>
                            </div>
                            <div class="sp-taught-course-body">
                                {{#category}}
                                    <span class="sp-taught-category-tag">{{category}}</span>
                                {{/category}}
                                <h4 class="sp-taught-course-title">{{fullname}}</h4>
                                {{#summary}}
                                    <div class="sp-taught-course-summary">{{{summary}}}</div>
                                {{/summary}}
                            </div>
                        </a>
                    {{/taughtcourses}}
                </div>
                {{/has_taughtcourses}}

                {{^has_taughtcourses}}
                <div class="sp-empty-notice">
                    <i class="fa fa-chalkboard" aria-hidden="true"></i>
                    <p>{{#str}}no_taught_courses, local_smartprofile{{/str}}</p>
                </div>
                {{/has_taughtcourses}}
            </div>

            <!-- Faculty: Academic Research & Profiles Card -->
            {{#has_research_links}}
            <div class="sp-portfolio-card">
                <div class="sp-card-title-row">
                    <h2 class="sp-card-heading">
                        <i class="fa fa-book-bookmark sp-head-icon" aria-hidden="true"></i> {{#str}}academic_research, local_smartprofile{{/str}}
                    </h2>
                </div>
                <div class="sp-research-links-row d-flex gap-2 flex-wrap mb-3">
                    {{#orcid_url}}
                        <a href="{{orcid_url}}" target="_blank" rel="noopener noreferrer" class="sp-research-badge-link sp-orcid-link">
                            <i class="fa-brands fa-orcid" aria-hidden="true"></i> <span>ORCID iD</span>
                        </a>
                    {{/orcid_url}}
                    {{#googlescholar}}
                        <a href="{{googlescholar}}" target="_blank" rel="noopener noreferrer" class="sp-research-badge-link sp-scholar-link">
                            <i class="fa-brands fa-google" aria-hidden="true"></i> <span>{{#str}}google_scholar, local_smartprofile{{/str}}</span>
                        </a>
                    {{/googlescholar}}
                    {{#researchgate}}
                        <a href="{{researchgate}}" target="_blank" rel="noopener noreferrer" class="sp-research-badge-link sp-rgate-link">
                            <i class="fa-brands fa-researchgate" aria-hidden="true"></i> <span>{{#str}}researchgate, local_smartprofile{{/str}}</span>
                        </a>
                    {{/researchgate}}
                </div>
                {{#has_research_interests}}
                <div class="sp-research-interests-section">
                    <h4 class="sp-subcard-title mb-2">{{#str}}research_interests, local_smartprofile{{/str}}</h4>
                    <div class="sp-skills-cloud">
                        {{#research_interests}}
                            <span class="sp-skill-bubble">{{.}}</span>
                        {{/research_interests}}
                    </div>
                </div>
                {{/has_research_interests}}
            </div>
            {{/has_research_links}}

            <!-- Faculty: Office Hours & Consultations Card -->
            {{#has_officehours}}
            <div class="sp-portfolio-card">
                <div class="sp-card-title-row">
                    <h2 class="sp-card-heading">
                        <i class="fa fa-calendar-days sp-head-icon" aria-hidden="true"></i> {{#str}}office_hours, local_smartprofile{{/str}}
                    </h2>
                </div>
                <div class="sp-officehours-content d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div class="sp-officehours-details">
                        {{#officelocation}}
                            <div class="sp-meta-entry mb-2">
                                <div class="sp-meta-icon"><i class="fa fa-door-open" aria-hidden="true"></i></div>
                                <div>
                                    <div class="sp-meta-k">{{#str}}office_location, local_smartprofile{{/str}}</div>
                                    <div class="sp-meta-v">{{officelocation}}</div>
                                </div>
                            </div>
                        {{/officelocation}}
                        {{#officehours}}
                            <div class="sp-meta-entry">
                                <div class="sp-meta-icon"><i class="fa fa-clock" aria-hidden="true"></i></div>
                                <div>
                                    <div class="sp-meta-k">{{#str}}office_hours, local_smartprofile{{/str}}</div>
                                    <div class="sp-meta-v">{{officehours}}</div>
                                </div>
                            </div>
                        {{/officehours}}
                    </div>
                    {{#has_bookingurl}}
                        <div>
                            <a href="{{bookingurl}}" target="_blank" rel="noopener noreferrer" class="btn btn-primary rounded-pill px-4 py-2 fw-bold d-inline-flex align-items-center gap-2">
                                <i class="fa fa-calendar-check" aria-hidden="true"></i> {{#str}}book_consultation, local_smartprofile{{/str}}
                            </a>
                        </div>
                    {{/has_bookingurl}}
                </div>
            </div>
            {{/has_officehours}}
            {{/faculty}}
            {{/isfaculty}}

            {{^isfaculty}}
            <!-- Learning Performance Card -->
            {{#showperformance}}
            {{#performance}}
            <div class="sp-portfolio-card">
                <div class="sp-card-title-row">
                    <h2 class="sp-card-heading">
